# WyrmGPT secrets TOML example
# Place as config.secrets.toml in the repo root.
# Keep this file out of git.

[providers.openai]
api_key = "paste-api-key-here"
# Get an API key at https://platform.openai.com/api-keys

[providers.google]
api_key = "paste-api-key-here"
# Get an API key at https://aistudio.google.com

[providers.anthropic]
api_key = "paste-api-key-here"
# Get an API key at https://platform.claude.com/settings/keys

[providers.brave]
api_key = "paste-api-key-here"
# Get an API key at https://api-dashboard.search.brave.com/app/keys

[vector]
api_key = ""
