{
  "artifact.plan_reading": {
    "module": "artifact_plan_reading",
    "enabled": true,
    "display_name": "Plan Artifact Reading",
    "description": "Inspect an artifact and return whether it should be included whole or through summary/index fallback for the current reading budget.",
    "tags": [
      "artifact",
      "reading",
      "planner"
    ],
    "input_schema": {
      "type": "object",
      "required": [
        "artifact_id"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "user_text": {
          "type": "string"
        },
        "budget_remaining_chars": {
          "type": "integer",
          "minimum": 0
        },
        "whole_artifact_soft_cap_chars": {
          "type": "integer",
          "minimum": 1000
        }
      }
    },
    "system_usage": "Use when the user explicitly asks for a reading plan or wants to inspect how the scaffold would handle a large artifact before reading."
  },
  "artifact.resolve_section": {
    "module": "artifact_resolve_section",
    "enabled": true,
    "display_name": "Resolve Artifact Section",
    "description": "Resolve a user-facing section reference like 'Section V' or a heading label to a concrete artifact chunk range.",
    "tags": [
      "artifact",
      "reading",
      "navigation"
    ],
    "input_schema": {
      "type": "object",
      "required": [
        "artifact_id",
        "section_ref"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "section_ref": {
          "type": "string",
          "minLength": 1
        },
        "max_candidates": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 20
        }
      }
    },
    "system_usage": "Use when the user refers to a named section, chapter, page, or heading and you need a concrete chunk range before reading."
  },
  "artifact.read_section": {
    "module": "artifact_read_section",
    "enabled": true,
    "display_name": "Read Artifact Section",
    "description": "Load a concrete artifact section or chunk range into a structured tool result.",
    "tags": [
      "artifact",
      "reading"
    ],
    "input_schema": {
      "type": "object",
      "required": [
        "artifact_id"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "section_ref": {
          "type": "string"
        },
        "chunk_start": {
          "type": "integer",
          "minimum": 0
        },
        "chunk_end": {
          "type": "integer",
          "minimum": 0
        },
        "session_id": {
          "type": "integer",
          "minimum": 1
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "mark_active": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "system_usage": "Use when the user explicitly wants a section read, or after artifact.resolve_section identifies the chunk range."
  },
  "artifact.start_session": {
    "module": "artifact_start_session",
    "enabled": true,
    "display_name": "Start Artifact Reading Session",
    "description": "Create or refresh a durable reading session with ordered reading steps derived from the artifact index.",
    "tags": [
      "artifact",
      "reading",
      "session"
    ],
    "input_schema": {
      "type": "object",
      "required": [
        "artifact_id"
      ],
      "properties": {
        "conversation_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "integer",
          "minimum": 1
        },
        "current_conversation_only": {
          "type": "boolean",
          "default": false
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "reading",
            "reference",
            "mixed"
          ],
          "default": "reading"
        },
        "strategy": {
          "type": [
            "object",
            "array",
            "string"
          ]
        },
        "restart": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "system_usage": "Use before reading a long artifact sequentially so progress and notes can be retained across turns."
  },
  "artifact.read_next": {
    "module": "artifact_read_next",
    "enabled": true,
    "display_name": "Read Next Artifact Step",
    "description": "Advance an artifact reading session to the next pending step and return the corresponding section text.",
    "tags": [
      "artifact",
      "reading",
      "session"
    ],
    "input_schema": {
      "type": "object",
      "required": [],
      "properties": {
        "session_id": {
          "type": "integer",
          "minimum": 1
        },
        "mark_active": {
          "type": "boolean",
          "default": true
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "conversation_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "system_usage": "Use only when the user clearly wants to continue reading, resume an in-progress session, or load the next section. Do not use for listing sessions, publishing transcripts, recaps, or other session-management requests."
  },
  "artifact.update_session_notes": {
    "module": "artifact_update_session_notes",
    "enabled": true,
    "display_name": "Update Artifact Session Notes",
    "description": "Persist summary-so-far and compact structured reading notes for one reading step.",
    "tags": [
      "artifact",
      "reading",
      "session",
      "notes"
    ],
    "input_schema": {
      "type": "object",
      "required": [
        "session_id",
        "ordinal"
      ],
      "properties": {
        "session_id": {
          "type": "integer",
          "minimum": 1
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "summary_so_far": {
          "type": "string"
        },
        "notes": {
          "type": [
            "object",
            "array",
            "string"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "active",
            "done",
            "skipped"
          ],
          "default": "done"
        },
        "session_status": {
          "type": "string",
          "enum": [
            "active",
            "paused",
            "complete",
            "dropped"
          ]
        },
        "current_chunk_position": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "system_usage": "Use after reading a section to store the running summary and short reflective notes for later continuation or retrieval."
  },
  "artifact.list_sessions": {
    "module": "artifact_list_sessions",
    "enabled": true,
    "display_name": "List Artifact Reading Sessions",
    "description": "Enumerate existing reading sessions filtered by artifact, title, date range, or conversation.",
    "tags": [
      "artifact",
      "reading",
      "session",
      "listing"
    ],
    "input_schema": {
      "type": "object",
      "required": [],
      "properties": {
        "conversation_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "integer",
          "minimum": 1
        },
        "current_conversation_only": {
          "type": "boolean",
          "default": false
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "title_query": {
          "type": "string",
          "minLength": 1
        },
        "created_after": {
          "type": "string",
          "minLength": 4
        },
        "created_before": {
          "type": "string",
          "minLength": 4
        },
        "include_complete": {
          "type": "boolean",
          "default": true
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      }
    },
    "system_usage": "Use when the user wants to list, enumerate, search, inspect, or choose among existing reading sessions. Within a project, default to project-wide search unless the user explicitly asks for only the current conversation. Prefer this over artifact.read_next when the request is about session discovery or metadata."
  },
  "artifact.publish_session": {
    "module": "artifact_publish_session",
    "enabled": true,
    "display_name": "Publish Reading Session",
    "description": "Create a durable artifact from a reading session, either as a compact recap or a fuller journal transcript.",
    "tags": [
      "artifact",
      "reading",
      "session",
      "publish"
    ],
    "input_schema": {
      "type": "object",
      "required": [
        "session_id"
      ],
      "properties": {
        "session_id": {
          "type": "integer",
          "minimum": 1
        },
        "publish_kind": {
          "type": "string",
          "enum": [
            "reading_recap",
            "reading_journal_transcript"
          ],
          "default": "reading_journal_transcript"
        },
        "title": {
          "type": "string"
        },
        "retain_in_conversation": {
          "type": "boolean",
          "default": true
        },
        "scope_type": {
          "type": "string",
          "enum": [
            "conversation",
            "project",
            "global"
          ]
        }
      }
    },
    "system_usage": "Use when the user wants a transcript, journal transcript, recap, export, publication, or other durable artifact derived from a completed or in-progress reading session. Prefer this over artifact.read_next when the request is about outputs from the session rather than reading more text."
  },
  "web.ingest_url": {
    "module": "web_ingest_url",
    "enabled": true,
    "display_name": "Fetch Web URL",
    "description": "Fetch and ingest a specific web URL into the current conversation as a retained artifact.",
    "tags": [
      "web",
      "artifact",
      "ingest"
    ],
    "input_schema": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 8
        },
        "conversation_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "system_usage": "Use when the assistant wants to retrieve a specific URL it has seen and turn it into a readable artifact in the current conversation."
  },
  "memory.create": {
    "module": "memory_create",
    "enabled": true,
    "display_name": "Create Memory",
    "description": "Create a durable memory at project or global scope from information worth remembering later.",
    "tags": [
      "memory",
      "corpus",
      "persistence"
    ],
    "input_schema": {
      "type": "object",
      "required": [
        "content"
      ],
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1
        },
        "importance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 50
        },
        "tags": {
          "type": [
            "string",
            "array"
          ]
        },
        "scope_type": {
          "type": "string",
          "enum": [
            "project",
            "global"
          ]
        },
        "scope_id": {
          "type": "integer",
          "minimum": 1
        },
        "origin_kind": {
          "type": "string"
        }
      }
    },
    "system_usage": "Use when the assistant wants to save a durable project or global memory from the current conversation for later retrieval. Prefer project scope when the memory is specific to this project; otherwise use global."
  }
}
