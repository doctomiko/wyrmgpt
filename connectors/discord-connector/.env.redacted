_MAINPY_SANITY_ENV=2025-12-23-a
MULTI_TENANT=false
DEV_GUILD_ID=1374761458813894758

# Sensitive keys and tokens
# Be careful with these!
# DO NOT POST THIS FILE TO DISCORD OR GITHUB OR ANY PUBLIC PLACE
# Ensure code does not leak the values of these environment variables in logs
DISCORD_TOKEN=[REDACTED]
# https://discord.com/developers/applications
#
OPENAI_API_KEY=[REDACTED]
# https://platform.openai.com/api-keys

# Logging levels
LOG_LEVEL=INFO
LOG_SQL_EVERY_MESSAGE=false

# Where to find important config files, etc.
SYSTEM_PROMPT_PATH=./prompts/system_prompt.txt
# Storage
SQLITE_PATH=./data/callie.sqlite3

# -------------------------
# Guild Level Configuration
# -------------------------

# Acccess controls
# Hard gate: only respond inside this channel (Callie Desk)
ALLOWED_CHANNEL_IDS=1451360806418645217
# Roles allowed to use Callie (comma-separated role IDs)
ALLOWED_ROLE_IDS=1451361022538551449
# Optional: only allow these roles to use slash commands (comma-separated role IDs)
# Admin, Nearly Admin, Moderator
ADMIN_ROLE_IDS=1374773323887546439,1443690544860495963,1374776710024921130
# Determines if REQUIRE_CALLIE_ROLE is enforced in allowed channels
ROLE_CHANNELS_ACCESS_MODE=AND
REQUIRE_CALLIE_ROLE=true

# Session behavior
SESSION_TTL_MINUTES=180
REPLY_POLICY=Mention
MSG_ENRICH_POLICY=Full
# was AMBIENT_DEFAULT=0
# Setting to true prevents Callie from replying
# to ambient messages when they are a mention or reply
# to another user and she is not explicitly invoked.
SUPPRESS_AMBIENT_REPLIES=true

# Message history
#HISTORY_MAX_MESSAGES=20
#HISTORY_MAX_TOKENS=3000
#HISTORY_MAX_MESSAGES_LONG=60
#HISTORY_MAX_TOKENS_LONG=9000
#HISTORY_USE_SUMMARIES=true
#HISTORY_SUMMARY_TARGET_TOKENS=300
#HISTORY_SUMMARY_INTERVAL=25
# When to drop messages instead of summarizing
#HISTORY_TRIGGER_DROPPED_MIN_MESSAGES=20
# When to use long history settings
#HISTORY_USE_LONG_AFTER_MESSAGES=50
#HISTORY_USE_LONG_AFTER_TOKENS=7000

# Summary settings
SUMMARY_ENABLED=true
SUMMARY_TRIGGER_DROPPED_MIN_MESSAGES=20
SUMMARY_BATCH_MIN_MESSAGES=25
SUMMARY_BATCH_MAX_MESSAGES=50
SUMMARY_BATCH_MAX_CHARS=18000
SUMMARY_TARGET_MAX_TOKENS=800
SUMMARY_MIN_INTERVAL_SECONDS=600
SUMMARY_MAX_LOOPS=5
#MEMORY_USE_SUMMARIES=true # phased out, replaced by SUMMARY_ENABLED instead
# MEMORY_SUMMARY_INTERVAL # phased out, replaced by SUMMARY_MIN_INTERVAL_SECONDS

# Callie Memory Management
MEMORY_NEWEST=15
MEMORY_OLDEST=15
MEMORY_RANDOM=25

# Model config (OpenAI Responses API)
OPENAI_MODEL=gpt-5.2
MAX_OUTPUT_TOKENS=800
MAX_OUTPUT_TOKENS_LONG=2800
CONTEXT_MESSAGES=180
CONTEXT_TOKEN_LIMIT=12000
CONTEXT_SUMMARY_TARGET_TOKENS=180
# A safetty holder for sending messages to OpenAI
REQUIRE_SERVER_CONTEXT=true

# For ignore command
IGNORE_DEFAULT_MINUTES=15
IGNORE_MAX_MINUTES=30

# For file attachements
# reply = inspect files/images whenever Callie is already going to reply.
# invoked = require a mention/reply before inspecting files/images.
# disabled = never inspect files/images.
ATTACHMENT_INSPECTION_POLICY=reply
MAX_ATTACHMENT_MB=50
MAX_FILES_API_MB=512
# Attachment extension policy (CSV lists; include dots or not, either works)
# If you omit these, code uses its internal defaults.
ALLOWED_ATTACHMENT_EXTS=.png,.jpg,.jpeg,.gif,.webp,.pdf,.txt,.md,.rtf,.doc,.docx,.odt,.csv,.xlsx,.pptx,.json,.xml,.yaml,.yml,.zip,.7z,.rar,.py,.js,.ts,.tsx,.java,.cs,.c,.cpp,.rs,.go,.php,.rb,.sql,.sh,.mp3,.wav,.flac,.mp4,.mov,.mkv,.webm
BLOCKED_ATTACHMENT_EXTS=.exe,.dll,.msi,.com,.bat,.cmd,.scr,.pif,.apk,.jar,.dmg,.app,.deb,.rpm
TEXT_INJECT_MAX_CHARS=500000
UPLOAD_THROTTLE_ENABLED=1
NONADMIN_UPLOAD_LIMIT_HOURLY_MB=100
NONADMIN_UPLOAD_LIMIT_DAILY_MB=100

# DISCORD SETTINGS

# Configurable chunking of Discord messages
DISCORD_MSG_LIMIT=2000
DISCORD_SAFE_LIMIT=1900

# Discord rate limiters
DISCORD_SEND_COOLDOWN_SECONDS=0.5
DISCORD_SEND_MAX_RETRIES=5
DISCORD_SEND_RETRY_BASE_SECONDS=0.8
DISCORD_SEND_RETRY_MAX_SECONDS=8.0
DISCORD_SEND_RETRY_JITTER_SECONDS=0.2

